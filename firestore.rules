rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Rollover lock guard ───────────────────────────────────────────
    // Returns true when a year-end rollover is in progress (Steps 2–4).
    // Blocks all academic writes to prevent data interleaving during rollover.
    function rolloverLocked(database) {
      let lockPath = /databases/$(database)/documents/settings/rollover_lock;
      return exists(lockPath) && get(lockPath).data.get('locked', false) == true;
    }

    // ── Teacher lock guard ──────────────────────────────────────────────
    // Admin-controlled kill switch: settings/teacher_lock { lockAll: bool,
    // lockedUids: [uid, ...] }. Blocks teacher (not admin/office) writes to
    // academic collections while an admin is working on/inspecting teacher
    // accounts. Mirrors rolloverLocked() in scope and shape.
    function teacherLocked(database, uid) {
      let lockPath = /databases/$(database)/documents/settings/teacher_lock;
      return exists(lockPath) &&
        (get(lockPath).data.get('lockAll', false) == true ||
         uid in get(lockPath).data.get('lockedUids', []));
    }

    // ── Role helpers ─────────────────────────────────────────────────
    function isRole(role) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    // office staff may be stored as 'office' or 'office_staff'
    function isOffice()    { return isRole('office') || isRole('office_staff'); }
    function isTeacherAny() {
      return isRole('teacher') || isRole('class_teacher') || isRole('subject_teacher');
    }
    function isAnyStaff()  { return isRole('admin') || isOffice() || isTeacherAny(); }
    function isAdmin()     { return isRole('admin'); }
    function isOwner()     { return request.auth != null && request.auth.uid == resource.id; }

    // Maps a student's stored class ("1","2","LKG","SKG") to the label used on
    // assessment_sessions ("Class I","Class II","LKG","SKG"). Used to scope a
    // student's read of assessment_sessions to their own class only.
    function studentAssessmentClass() {
      let raw = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('class', '');
      return raw == '1' ? 'Class I' : (raw == '2' ? 'Class II' : raw);
    }

    // ── Class-teacher gate ────────────────────────────────────────────
    // Reviewing/locking an assessment_sessions doc (or touching one that's
    // already locked) is restricted to that class's class teacher — not any
    // teacher. `teachers/{teacherId}` stores classTeacherOf as "LKG"/"SKG"
    // directly, or a Roman numeral ("I".."X") for numbered classes; session
    // docs store the display name ("Class I"). Mirrors the UI-side check in
    // assessment-app/main.js (canReviewClass) which hides the buttons too —
    // this is the actual enforcement boundary.
    function classTeacherOfMatchesClass(classTeacherOf, className) {
      return classTeacherOf == className
        || (className == 'Class I'   && classTeacherOf == 'I')
        || (className == 'Class II'  && classTeacherOf == 'II')
        || (className == 'Class III' && classTeacherOf == 'III')
        || (className == 'Class IV'  && classTeacherOf == 'IV')
        || (className == 'Class V'   && classTeacherOf == 'V')
        || (className == 'Class VI'  && classTeacherOf == 'VI')
        || (className == 'Class VII' && classTeacherOf == 'VII')
        || (className == 'Class VIII' && classTeacherOf == 'VIII')
        || (className == 'Class IX'  && classTeacherOf == 'IX')
        || (className == 'Class X'   && classTeacherOf == 'X');
    }

    // Reads the assignment straight off the user's own doc. It must NOT go via
    // the `teachers` collection: that is keyed by staff initials ("IOH"), while
    // the only id available here is the staff id ("SFST015"), so
    // teachers/<staffId> never exists and this returned false for every
    // teacher — locking all of them out of review/lock and co-scholastic.
    // users/{uid}.tpClassTeacherOf holds the same value and is already fetched
    // by isRole(), so this is also one document read instead of two.
    function isClassTeacherOf(className) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return classTeacherOfMatchesClass(
        u.get('tpClassTeacherOf', u.get('classTeacherOf', '')),
        className
      );
    }

    // ── Users ────────────────────────────────────────────────────────
    // Each user manages their own doc; admin can read all.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read:        if isAdmin();
      allow write:       if isAdmin();
    }

    // ── Single active session per account ─────────────────────────────
    // Each user owns one session-claim doc. The client mints a sessionId on
    // login and watches this doc; if it changes (another device logged in),
    // the older device force-logs-out. Admin reads all (for a force-logout view).
    match /sessions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read:        if isAdmin();
    }

    // ── Device registry / login tracking ──────────────────────────────
    // One doc per (user, device): firstSeen, lastLogin, lastSeen, platform,
    // device label. Written by the user for their own devices; admin reads all
    // (and may delete stale entries). Tracks ALL roles, incl. admins.
    match /device_registry/{docId} {
      allow read:   if isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow write:  if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Students ─────────────────────────────────────────────────────
    match /students/{docId} {
      allow read:  if isAnyStaff() ||
        (request.auth != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == docId) ||
        // Sibling system: allow a student to read linked family members
        (request.auth != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student' &&
         resource.data.familyId != null &&
         resource.data.familyId ==
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId);
      allow write: if isAdmin() || isOffice();
    }

    // ── Daily attendance (with month-locking guard) ───────────────────
    match /attendance_daily/{docId} {
      allow read:  if isAnyStaff() || request.auth != null;
      allow write: if request.auth != null
        && ((isTeacherAny() && !teacherLocked(database, request.auth.uid)) || isAdmin())
        && !rolloverLocked(database)
        && (isDailyWriteAllowed(database, docId) || isAdmin());
    }

    // ── Monthly attendance snapshots (locking workflow) ───────────────
    match /attendance_monthly/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isAnyStaff() && !rolloverLocked(database);
      allow update: if isAnyStaff() && !rolloverLocked(database) && isMonthlyUpdateAllowed(database);
      allow delete: if false;
    }

    // ── Staff (teacher) daily attendance — geo-tagged check-in/out ────
    // Doc id: "{uid}_{YYYY-MM-DD}". Written ONLY by the recordStaffAttendance
    // Cloud Function (Admin SDK bypasses these rules) so the timestamp is
    // server-authoritative and cannot be spoofed from the device clock.
    // A teacher may read their own day docs; all staff/admin may read for the
    // live board and reports.
    match /staff_attendance/{docId} {
      allow read:  if isAnyStaff() ||
        (request.auth != null && docId.split('_')[0] == request.auth.uid);
      allow write: if false;
    }

    // ── Staff attendance monthly snapshots (lock workflow, mirrors
    //    attendance_monthly). Doc id: "{uid}_{YYYY}_{MM}" or "ALL_{YYYY}_{MM}".
    match /staff_attendance_monthly/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isAdmin() && !rolloverLocked(database);
      allow update: if isAdmin() && !rolloverLocked(database);
      allow delete: if false;
    }

    // ── Fee transactions ─────────────────────────────────────────────
    match /fee_transactions/{docId} {
      allow read: if isAnyStaff() ||
        (request.auth != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId ==
         resource.data.studentId);
      allow write: if isAdmin() || isOffice();
    }

    // ── Fees (older collection — student notification center reads) ───
    match /fees/{docId} {
      allow read:  if isAnyStaff() ||
        (request.auth != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId ==
         resource.data.studentId);
      allow write: if isAdmin() || isOffice();
    }

    // ── Fee structure ─────────────────────────────────────────────────
    match /fee_structure/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() || isOffice();
    }

    // ── Homework ─────────────────────────────────────────────────────
    match /homework/{docId} {
      allow read:  if request.auth != null;
      allow write: if isTeacherAny() || isAdmin();
    }

    // ── Notices ──────────────────────────────────────────────────────
    match /notices/{docId} {
      allow read:  if true;
      allow write: if isAdmin() || isTeacherAny();
    }

    // ── Public-read / admin-write collections ─────────────────────────
    match /events/{docId}         { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{docId}        { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{docId}  { allow read: if true; allow write: if isAdmin(); }
    match /teachers/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /classes/{docId}        { allow read: if isAnyStaff(); allow write: if isAdmin(); }
    match /settings/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /public_settings/{docId}{ allow read: if true; allow write: if isAdmin(); }
    match /holidays/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /academicSessions/{docId}{ allow read: if true; allow write: if isAdmin(); }
    match /why_choose_us/{docId}  { allow read: if true; allow write: if isAdmin(); }
    match /school_leaders/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /quotes/{docId}         { allow read: if true; allow write: if isAdmin(); }

    // ── Admissions: public create; staff reads/updates ────────────────
    match /admissions/{docId} {
      allow create:        if true;
      allow read, update:  if isAnyStaff();
      allow delete:        if isAdmin();
    }

    // ── Contacts: public create; admin reads ─────────────────────────
    match /contacts/{docId} {
      allow create:     if true;
      allow read, write: if isAdmin();
    }

    // ── Leave applications ───────────────────────────────────────────
    match /leave_applications/{docId} {
      allow create: if request.auth != null;
      allow read:   if isAnyStaff();
      allow update: if isAdmin();
    }

    // ── New account links (Google sign-in self-linking) ───────────────
    match /newAccountLinks/{docId} {
      allow create: if request.auth != null;
      allow read:   if isAdmin();
    }

    // ── Marks (mark entry system — subject & class teachers) ─────────
    // A student may read BOTH their term docs (HY + FT) once the admin has
    // released the report card. Release sets releasedToStudent on the Final
    // Term ("{classId}_FT") doc, so both terms gate on that single flag.
    match /marks/{termDoc}/students/{studentId} {
      allow read:  if isAnyStaff() ||
        (request.auth != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == studentId &&
         ftReleasedForStudent(database, termDoc, studentId));
      allow write: if ((isTeacherAny() && !teacherLocked(database, request.auth.uid)) || isAdmin()) && !rolloverLocked(database);
    }

    // ── Routine / Timetable ──────────────────────────────────────────
    match /routine/{document=**} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Subjects ─────────────────────────────────────────────────────
    match /subjects/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Student messages ─────────────────────────────────────────────
    match /student_messages/{docId} {
      allow read:   if isAnyStaff() ||
        (request.auth != null &&
         resource.data.to == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId);
      allow create: if request.auth != null;
      allow update, delete: if isAnyStaff();
    }

    // ── Assessment sessions ───────────────────────────────────────────
    // Locking co-scholastic for a class+term (below) also locks every
    // REVIEWED session for that class+term from the client — see
    // lockReviewedSessionsForClassTerm in session-review-engine.js. That's a
    // burst of admin-authored status writes, not a new permission: isAdmin()
    // already allows it below, same as any other admin status change.
    match /assessment_sessions/{docId} {
      allow read:  if isAnyStaff();
      // A student may read sessions for their own class only (powers the
      // "My Progress" tab, which filters to their own marks client-side).
      allow read:  if request.auth != null
        && isRole('student')
        && resource.data.session.class == studentAssessmentClass();
      // Creating/editing a session (draft entry, autosave, draft<->submitted)
      // stays open to any subject teacher. Moving status to 'reviewed' or
      // 'locked' — or writing to a doc that's already 'locked' at all
      // (including reopening it) — is further restricted to that class's
      // class teacher, since that's the sole reviewer now.
      allow create: if !rolloverLocked(database) && (
        isAdmin() ||
        (
          isTeacherAny() && !teacherLocked(database, request.auth.uid) &&
          (request.resource.data.session.status in ['reviewed', 'locked']
            ? isClassTeacherOf(request.resource.data.session.class)
            : true)
        )
      );
      allow update: if !rolloverLocked(database) && (
        isAdmin() ||
        (
          isTeacherAny() && !teacherLocked(database, request.auth.uid) &&
          ((request.resource.data.session.status in ['reviewed', 'locked'] || resource.data.session.status == 'locked')
            ? isClassTeacherOf(resource.data.session.class)
            : true)
        )
      );
      // Hard delete is admin-only (e.g. removing test/junk sessions from the
      // admin Sessions screen) — teachers use status transitions instead.
      allow delete: if isAdmin() && !rolloverLocked(database);
    }

    // ── Monthly analytics ─────────────────────────────────────────────
    match /monthly_analytics/{docId} {
      allow read:  if isAnyStaff();
      allow write: if ((isTeacherAny() && !teacherLocked(database, request.auth.uid)) || isAdmin()) && !rolloverLocked(database);
    }

    // ── Weak student flags ────────────────────────────────────────────
    match /weak_students/{docId} {
      allow read:  if isAnyStaff();
      allow write: if ((isTeacherAny() && !teacherLocked(database, request.auth.uid)) || isAdmin()) && !rolloverLocked(database);
    }

    // ── Term analytics (Half-Yearly rollup) ───────────────────────────
    match /term_analytics/{docId} {
      allow read:  if isAnyStaff();
      allow write: if ((isTeacherAny() && !teacherLocked(database, request.auth.uid)) || isAdmin()) && !rolloverLocked(database);
    }

    // ── Class test marks (Half-Yearly, Class I/II) ────────────────────
    match /class_test_marks/{docId} {
      allow read:  if isAnyStaff();
      allow write: if ((isTeacherAny() && !teacherLocked(database, request.auth.uid)) || isAdmin()) && !rolloverLocked(database);
    }

    // ── Co-scholastic grades (LKG/SKG/Class I/II) ─────────────────────
    // One doc per class+term ("HY1_Class_II") holding a letter grade per
    // student per co-scholastic subject. Filled in as a single class-teacher
    // form covering all subjects, so writes are restricted to that class's
    // class teacher (or admin) — not any teacher. Mirrored in the UI by
    // main.js only offering classes the signed-in teacher is responsible for.
    match /coscholastic_marks/{docId} {
      allow read:  if isAnyStaff();
      allow read:  if request.auth != null
        && isRole('student')
        && resource.data.class == studentAssessmentClass();
      // `status` is 'draft' or 'locked'. Locking is ADMIN ONLY: a class teacher
      // can fill and refill their own grid freely, but once an admin locks it
      // they cannot touch it again, and they can never set or clear the flag
      // themselves. Absent status reads as 'draft' so documents written before
      // this existed stay editable.
      allow create: if !rolloverLocked(database) && (
        isAdmin() ||
        (
          isTeacherAny() && !teacherLocked(database, request.auth.uid) &&
          isClassTeacherOf(request.resource.data.class) &&
          request.resource.data.get('status', 'draft') == 'draft'
        )
      );
      allow update: if !rolloverLocked(database) && (
        isAdmin() ||
        (
          isTeacherAny() && !teacherLocked(database, request.auth.uid) &&
          isClassTeacherOf(request.resource.data.class) &&
          resource.data.get('status', 'draft') != 'locked' &&
          request.resource.data.get('status', 'draft') == resource.data.get('status', 'draft')
        )
      );
      allow delete: if isAdmin() && !rolloverLocked(database);
    }

    // ── Student academic profiles ─────────────────────────────────────
    match /student_profiles/{docId} {
      allow read:  if isAnyStaff() ||
        (request.auth != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == docId);
      allow write: if ((isTeacherAny() && !teacherLocked(database, request.auth.uid)) || isAdmin()) && !rolloverLocked(database);
    }

    // ── Admin notifications ──────────────────────────────────────────
    match /admin_notifications/{docId} {
      allow read, write: if isAdmin() || isOffice();
    }

    // ── Office notifications (admin → office feedback) ────────────────
    match /office_notifications/{docId} {
      allow read, write: if isAdmin() || isOffice();
    }

    // ── Fee queries ───────────────────────────────────────────────────
    match /fee_queries/{docId} {
      allow create: if request.auth != null;
      allow read:   if isAnyStaff() ||
        (request.auth != null &&
         resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId);
      allow update: if isAdmin() || isOffice();
      allow delete: if false;
    }

    // ── Audit log ────────────────────────────────────────────────────
    match /audit_log/{docId} {
      allow read:  if isAdmin();
      allow create: if isAnyStaff();
      allow update, delete: if false;
    }

    // ── Notification logs (audit trail for scheduled pushes) ─────────
    // Written ONLY by Cloud Functions via the Admin SDK (which bypasses these
    // rules); no client may write. Admin reads them for the audit view.
    match /notification_logs/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Report Cards ──────────────────────────────────────────────────
    match /report_cards/{docId} {
      allow read, write: if isAdmin();
      allow read:        if isAnyStaff();
      allow read:        if request.auth != null
        && isRole('student')
        && resource.data.studentId ==
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId
        && resource.data.status == 'released';
    }

    // ── Parent report-card lookup (temporary, no-login feature) ───────
    // The lookupReportCard Cloud Function reads/writes this via the Admin
    // SDK, which bypasses rules entirely — no client may touch it directly.
    // (settings/report_card_lookup itself is already covered by the generic
    // /settings/{docId} rule above: public read, admin-only write.)
    match /lookup_attempts/{docId} {
      allow read, write: if false;
    }

  }

  // ── Helper: has the student's Final Term report card been released? ──
  // termDoc is "{classId}_HY" or "{classId}_FT"; the FT doc holds the flag.
  function ftReleasedForStudent(database, termDoc, studentId) {
    let base = termDoc.split('_')[0];
    let ftPath = /databases/$(database)/documents/marks/$(base + '_FT')/students/$(studentId);
    return exists(ftPath) && get(ftPath).data.get('releasedToStudent', false) == true;
  }

  // ── Helper: is the daily doc's month unlocked? ───────────────────────
  // docId format: "{classNum}_{YYYY-MM-DD}"
  function isDailyWriteAllowed(database, docId) {
    let parts    = docId.split('_');
    let classNum = parts[0];
    let datePart = parts[1];
    let yyyy     = datePart.split('-')[0];
    let mm       = datePart.split('-')[1];
    let monthKey = classNum + '_' + yyyy + '_' + mm;
    let monthPath = /databases/$(database)/documents/attendance_monthly/$(monthKey);
    return !exists(monthPath) || get(monthPath).data.get('status', '') != 'locked';
  }

  // ── Helper: monthly snapshot update rules ────────────────────────────
  //   draft  → any staff can update (regenerate)
  //   locked → only admin/super_admin can update
  //   unlock (locked→draft) → only super_admin
  function isMonthlyUpdateAllowed(database) {
    let currentlyLocked = resource.data.status == 'locked';
    let tryingToUnlock  = request.resource.data.status == 'draft';
    let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    return !currentlyLocked
      || (role == 'admin' || role == 'super_admin');
  }
}
